diff --git a/src/android_serial_bridge.c b/src/android_serial_bridge.c
new file mode 100644
index 00000000..548fa9d5
--- /dev/null
+++ b/src/android_serial_bridge.c
@@ -0,0 +1,446 @@
+/*
+ *  Hamlib Interface - Android USB serial bridge
+ *
+ *  Based on the Android USB serial bridge from JS8Android, used under the
+ *  LGPL with its author's permission. Reworked to take the host callbacks
+ *  through a registered table (so libhamlib can be a shared library with no
+ *  undefined symbols), to drop the Bluetooth transport, and to make open and
+ *  close safe against concurrent callers and a device being unplugged.
+ *
+ *   This library is free software; you can redistribute it and/or
+ *   modify it under the terms of the GNU Lesser General Public
+ *   License as published by the Free Software Foundation; either
+ *   version 2.1 of the License, or (at your option) any later version.
+ *
+ *   This library is distributed in the hope that it will be useful,
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ *   Lesser General Public License for more details.
+ *
+ *   You should have received a copy of the GNU Lesser General Public
+ *   License along with this library; if not, write to the Free Software
+ *   Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
+ *
+ */
+
+#include <hamlib/config.h>
+
+#include "hamlib/rig.h"
+#include "hamlib/rpt_usb_serial.h"
+
+#ifndef __ANDROID__
+
+int HAMLIB_API rpt_usb_serial_register(const rpt_usb_serial_ops_t *ops)
+{
+    (void)ops;
+    return -RIG_ENIMPL;
+}
+
+#else /* __ANDROID__ */
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include "android_serial_bridge.h"
+
+#define USB_PREFIX "android-usb:"
+#define USB_PREFIX_LEN 12
+#define POLL_TIMEOUT_MS 100
+#define WRITE_TIMEOUT_MS 1000
+/* Consecutive read errors (about 2 s) before the device counts as gone. */
+#define MAX_READ_ERRORS 100
+
+/*
+ * One connection at a time. Hamlib reads and writes port->fd, which is one
+ * end of a socketpair; two threads move bytes between the other end and the
+ * host callbacks.
+ */
+typedef struct
+{
+    rpt_usb_serial_ops_t ops;
+    int fd_peer;
+    atomic_int running;
+    pthread_t rx_thread;
+    pthread_t tx_thread;
+    int rx_started;
+    int tx_started;
+} bridge_ctx_t;
+
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static rpt_usb_serial_ops_t g_ops;
+static int g_ops_set;
+static bridge_ctx_t *g_active;
+
+int HAMLIB_API rpt_usb_serial_register(const rpt_usb_serial_ops_t *ops)
+{
+    int ret = RIG_OK;
+
+    if (ops && (!ops->is_ready || !ops->open || !ops->read || !ops->write
+                || !ops->set_rts || !ops->set_dtr || !ops->flush || !ops->close))
+    {
+        return -RIG_EINVAL;
+    }
+
+    pthread_mutex_lock(&g_lock);
+
+    if (g_active)
+    {
+        ret = -RIG_BUSBUSY;
+    }
+    else if (ops)
+    {
+        g_ops = *ops;
+        g_ops_set = 1;
+    }
+    else
+    {
+        memset(&g_ops, 0, sizeof(g_ops));
+        g_ops_set = 0;
+    }
+
+    pthread_mutex_unlock(&g_lock);
+    return ret;
+}
+
+int android_serial_is_path(const char *pathname)
+{
+    return pathname && strncmp(pathname, USB_PREFIX, USB_PREFIX_LEN) == 0;
+}
+
+/* "android-usb:<deviceId>:<portIndex>", portIndex optional (default 0). */
+static int parse_path(const char *pathname, int *device_id, int *port_index)
+{
+    const char *cursor = pathname + USB_PREFIX_LEN;
+    char *end = NULL;
+    long value;
+
+    errno = 0;
+    value = strtol(cursor, &end, 10);
+
+    if (errno || end == cursor || value < 0)
+    {
+        return -1;
+    }
+
+    *device_id = (int)value;
+    *port_index = 0;
+
+    if (*end == '\0')
+    {
+        return 0;
+    }
+
+    if (*end != ':')
+    {
+        return -1;
+    }
+
+    cursor = end + 1;
+    value = strtol(cursor, &end, 10);
+
+    if (errno || end == cursor || *end != '\0' || value < 0)
+    {
+        return -1;
+    }
+
+    *port_index = (int)value;
+    return 0;
+}
+
+/* Waking Hamlib with EOF on its fd is how a lost device shows up as an error. */
+static void stop_pipe(bridge_ctx_t *ctx)
+{
+    atomic_store(&ctx->running, 0);
+    shutdown(ctx->fd_peer, SHUT_RDWR);
+}
+
+/* USB -> Hamlib */
+static void *rx_thread_fn(void *arg)
+{
+    bridge_ctx_t *ctx = (bridge_ctx_t *)arg;
+    unsigned char buffer[512];
+    int error_streak = 0;
+
+    while (atomic_load(&ctx->running))
+    {
+        int n = ctx->ops.read(buffer, sizeof(buffer), POLL_TIMEOUT_MS);
+
+        if (n > 0)
+        {
+            int sent = 0;
+            error_streak = 0;
+
+            while (sent < n && atomic_load(&ctx->running))
+            {
+                /* MSG_NOSIGNAL: a closed peer must not raise SIGPIPE. */
+                ssize_t r = send(ctx->fd_peer, buffer + sent, n - sent, MSG_NOSIGNAL);
+
+                if (r > 0) { sent += (int)r; }
+                else if (r < 0 && errno == EINTR) { continue; }
+                else { break; }
+            }
+        }
+        else if (n == 0)
+        {
+            error_streak = 0;
+        }
+        else if (n == RPT_USB_SERIAL_EGONE || ++error_streak >= MAX_READ_ERRORS)
+        {
+            rig_debug(RIG_DEBUG_ERR, "%s: USB serial device lost (%d)\n",
+                      __func__, n);
+            stop_pipe(ctx);
+            break;
+        }
+        else
+        {
+            if (error_streak == 1)
+            {
+                rig_debug(RIG_DEBUG_WARN, "%s: USB read failed (%d)\n", __func__, n);
+            }
+
+            usleep(20000);
+        }
+    }
+
+    return NULL;
+}
+
+/* Hamlib -> USB */
+static void *tx_thread_fn(void *arg)
+{
+    bridge_ctx_t *ctx = (bridge_ctx_t *)arg;
+    unsigned char buffer[512];
+
+    while (atomic_load(&ctx->running))
+    {
+        ssize_t n = recv(ctx->fd_peer, buffer, sizeof(buffer), 0);
+
+        if (n > 0)
+        {
+            int done = 0;
+
+            while (done < n && atomic_load(&ctx->running))
+            {
+                int w = ctx->ops.write(buffer + done, (int)n - done, WRITE_TIMEOUT_MS);
+
+                if (w > 0) { done += w; continue; }
+
+                rig_debug(RIG_DEBUG_ERR, "%s: USB write failed (%d)\n", __func__, w);
+
+                if (w == RPT_USB_SERIAL_EGONE) { stop_pipe(ctx); }
+
+                break;
+            }
+        }
+        else if (n < 0 && errno == EINTR)
+        {
+            continue;
+        }
+        else
+        {
+            break; /* 0 = shut down by close or by the RX thread */
+        }
+    }
+
+    return NULL;
+}
+
+int android_serial_open(hamlib_port_t *port)
+{
+    bridge_ctx_t *ctx;
+    int device_id;
+    int port_index;
+    int fds[2] = { -1, -1 };
+    int ret;
+
+    if (!port) { return -RIG_EINVAL; }
+
+    if (parse_path(port->pathname, &device_id, &port_index) != 0)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: bad path '%s', expected "
+                  USB_PREFIX "<deviceId>:<portIndex>\n", __func__, port->pathname);
+        return -RIG_EINVAL;
+    }
+
+    pthread_mutex_lock(&g_lock);
+
+    if (!g_ops_set || !g_ops.is_ready())
+    {
+        pthread_mutex_unlock(&g_lock);
+        rig_debug(RIG_DEBUG_ERR, "%s: host USB serial layer not ready\n", __func__);
+        return -RIG_EIO;
+    }
+
+    if (g_active)
+    {
+        pthread_mutex_unlock(&g_lock);
+        rig_debug(RIG_DEBUG_ERR, "%s: a USB serial connection is already open\n",
+                  __func__);
+        return -RIG_BUSBUSY;
+    }
+
+    ctx = calloc(1, sizeof(*ctx));
+
+    if (!ctx)
+    {
+        pthread_mutex_unlock(&g_lock);
+        return -RIG_ENOMEM;
+    }
+
+    ctx->ops = g_ops;
+    ctx->fd_peer = -1;
+
+    ret = ctx->ops.open(device_id, port_index, port->parm.serial.rate,
+                        port->parm.serial.data_bits, port->parm.serial.stop_bits,
+                        (int)port->parm.serial.parity);
+
+    if (ret < 0)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: host open of device %d port %d failed (%d)\n",
+                  __func__, device_id, port_index, ret);
+        free(ctx);
+        pthread_mutex_unlock(&g_lock);
+        return -RIG_EIO;
+    }
+
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: socketpair: %s\n", __func__, strerror(errno));
+        ctx->ops.close();
+        free(ctx);
+        pthread_mutex_unlock(&g_lock);
+        return -RIG_EIO;
+    }
+
+    ctx->fd_peer = fds[1];
+    atomic_store(&ctx->running, 1);
+
+    if (pthread_create(&ctx->rx_thread, NULL, rx_thread_fn, ctx) == 0)
+    {
+        ctx->rx_started = 1;
+    }
+
+    if (ctx->rx_started && pthread_create(&ctx->tx_thread, NULL, tx_thread_fn, ctx) == 0)
+    {
+        ctx->tx_started = 1;
+    }
+
+    if (!ctx->tx_started)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: could not start bridge threads\n", __func__);
+        stop_pipe(ctx);
+
+        if (ctx->rx_started) { pthread_join(ctx->rx_thread, NULL); }
+
+        ctx->ops.close();
+        close(fds[0]);
+        close(fds[1]);
+        free(ctx);
+        pthread_mutex_unlock(&g_lock);
+        return -RIG_EIO;
+    }
+
+    g_active = ctx;
+    port->handle = ctx;
+    port->fd = fds[0];
+    pthread_mutex_unlock(&g_lock);
+
+    rig_debug(RIG_DEBUG_VERBOSE, "%s: opened device %d port %d at %d baud\n",
+              __func__, device_id, port_index, port->parm.serial.rate);
+    return RIG_OK;
+}
+
+int android_serial_close(hamlib_port_t *port)
+{
+    bridge_ctx_t *ctx;
+
+    if (!port) { return -RIG_EINVAL; }
+
+    pthread_mutex_lock(&g_lock);
+    ctx = (bridge_ctx_t *)port->handle;
+
+    if (!ctx || ctx != g_active)
+    {
+        pthread_mutex_unlock(&g_lock);
+        return RIG_OK;
+    }
+
+    /* Stop the pipe first so no callback runs after the host closes. */
+    stop_pipe(ctx);
+    pthread_join(ctx->tx_thread, NULL);
+    pthread_join(ctx->rx_thread, NULL);
+    ctx->ops.close();
+
+    close(ctx->fd_peer);
+
+    if (port->fd >= 0) { close(port->fd); }
+
+    port->fd = -1;
+    port->handle = NULL;
+    g_active = NULL;
+    free(ctx);
+    pthread_mutex_unlock(&g_lock);
+    return RIG_OK;
+}
+
+int android_serial_flush(hamlib_port_t *port)
+{
+    bridge_ctx_t *ctx;
+    unsigned char buffer[256];
+
+    if (!port) { return -RIG_EINVAL; }
+
+    /* Discard anything already handed to Hamlib but not yet read. */
+    if (port->fd >= 0)
+    {
+        while (recv(port->fd, buffer, sizeof(buffer), MSG_DONTWAIT) > 0) { }
+    }
+
+    pthread_mutex_lock(&g_lock);
+    ctx = (bridge_ctx_t *)port->handle;
+
+    if (ctx && ctx == g_active)
+    {
+        (void)ctx->ops.flush();
+    }
+
+    pthread_mutex_unlock(&g_lock);
+    return RIG_OK;
+}
+
+static int set_line(hamlib_port_t *port, int state, int is_rts)
+{
+    bridge_ctx_t *ctx;
+    int ret = -RIG_EIO;
+
+    if (!port) { return -RIG_EINVAL; }
+
+    pthread_mutex_lock(&g_lock);
+    ctx = (bridge_ctx_t *)port->handle;
+
+    if (ctx && ctx == g_active)
+    {
+        int r = is_rts ? ctx->ops.set_rts(state) : ctx->ops.set_dtr(state);
+        ret = r < 0 ? -RIG_EIO : RIG_OK;
+    }
+
+    pthread_mutex_unlock(&g_lock);
+    return ret;
+}
+
+int android_serial_set_rts(hamlib_port_t *port, int state)
+{
+    return set_line(port, state, 1);
+}
+
+int android_serial_set_dtr(hamlib_port_t *port, int state)
+{
+    return set_line(port, state, 0);
+}
+
+#endif /* __ANDROID__ */
